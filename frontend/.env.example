# Copy this file to .env and fill in real values before deploying.
# NEVER commit .env to version control.

# ── API base URL ──────────────────────────────────────────────────────────────
# Local development (Vite proxies /api → backend, so this may not be needed):
# VITE_API_URL=http://localhost:8000

# Production (Railway backend URL):
# VITE_API_URL=https://your-backend.railway.app

# ── Social OAuth (production only) ───────────────────────────────────────────
# These would be used in a real OAuth implementation.
# For the current demo, social login is simulated without these values.

# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# VITE_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
# VITE_MICROSOFT_CLIENT_ID=your-azure-app-registration-client-id
# VITE_MICROSOFT_TENANT_ID=your-azure-tenant-id
